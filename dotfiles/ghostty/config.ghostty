# --- Theme & Colors ---
theme = noctalia

# --- Typography & Font Ligatures ---
font-family = Fira Code
font-family = Symbols Nerd Font Mono
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-size = 12
adjust-box-thickness = 1
adjust-icon-height = 20%

# --- Window Styling & Layout ---
background-opacity = 0.8
background-blur = true
window-padding-x = 16
window-padding-y = 8,2
window-padding-balance = false
window-decoration = auto
window-theme = ghostty
confirm-close-surface = false
maximize = true

# --- Cursor Customization ---
cursor-style = bar
cursor-style-blink = true
adjust-cursor-thickness = 3

# --- Select, Copy & Paste (Matching Kitty 1:1) ---
copy-on-select = clipboard
right-click-action = paste
clipboard-paste-protection = false
clipboard-paste-bracketed-safe = true
clipboard-trim-trailing-spaces = false
app-notifications = no-clipboard-copy
selection-clear-on-copy = false
selection-clear-on-typing = true

# --- Hyperlinks & URLs ---
link-url = true
link-previews = true

# --- Tabs (Bottom-left, compact, seamless background) ---
gtk-tabs-location = bottom
gtk-wide-tabs = false
gtk-toolbar-style = flat
gtk-custom-css = ?~/.config/ghostty/gtk.css
window-new-tab-position = end
tab-inherit-working-directory = false
working-directory = home

# --- Audio & Shell ---
command = /usr/bin/fish
bell-features = no-audio

# --- Keybindings ---
keybind = ctrl+shift+c=copy_to_clipboard:plain
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+t=new_tab
keybind = ctrl+shift+t=new_tab
keybind = ctrl+w=previous_tab
keybind = chain=close_tab:this
keybind = ctrl+shift+w=previous_tab
keybind = chain=close_tab:this
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+shift+right=next_tab
keybind = ctrl+shift+left=previous_tab
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = ctrl+shift+enter=new_window
keybind = ctrl+shift+[=goto_split:previous
keybind = ctrl+shift+]=goto_split:next
keybind = ctrl+shift+k=clear_screen
keybind = ctrl+l=clear_screen
keybind = ctrl+shift+a=toggle_tab_overview
