[Unit]
Description=Bluetooth Device Battery to Alias Synchronizer
PartOf=hyprland-session.target
After=hyprland-session.target bluetooth.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.config/hypr/scripts/bt_battery_sync.py
Restart=always
RestartSec=2s

[Install]
WantedBy=hyprland-session.target
