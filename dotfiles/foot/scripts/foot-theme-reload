#!/usr/bin/env python3
"""
foot-theme-reload: Broadcasts dynamic palette updates and transparency to
all running Foot terminal windows and attached tmux client PTYs via OSC escape
sequences, and triggers tmux to re-evaluate active Noctalia status pills.
"""

import glob
import os
import re
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
FOOT_INI = HOME / ".config" / "foot" / "foot.ini"
DEFAULT_THEME = HOME / ".config" / "foot" / "themes" / "noctalia"


def get_active_theme_path(theme_arg=None):
    if theme_arg:
        p = Path(theme_arg).expanduser()
        if p.is_file():
            return p
        user_p = HOME / ".config" / "foot" / "themes" / theme_arg
        if user_p.is_file():
            return user_p
        sys_p = Path("/usr/share/foot/themes") / theme_arg
        if sys_p.is_file():
            return sys_p

    # Check foot.ini for active include directive
    if FOOT_INI.is_file():
        text = FOOT_INI.read_text(encoding="utf-8", errors="ignore")
        m = re.search(r"^[ \t]*include[ \t]*=[ \t]*(.+)$", text, re.MULTILINE)
        if m:
            candidate = Path(os.path.expanduser(m.group(1).strip()))
            if candidate.is_file():
                return candidate

    if DEFAULT_THEME.is_file():
        return DEFAULT_THEME
    return None


def get_alpha_percentage():
    if FOOT_INI.is_file():
        text = FOOT_INI.read_text(encoding="utf-8", errors="ignore")
        m = re.search(r"^[ \t]*alpha[ \t]*=[ \t]*([0-9.]+)", text, re.MULTILINE)
        if m:
            try:
                val = float(m.group(1))
                return max(0, min(100, int(round(val * 100))))
            except ValueError:
                pass
    return 67


def parse_foot_theme(theme_path):
    if not theme_path or not theme_path.is_file():
        return {}
    colors = {}
    lines = theme_path.read_text(encoding="utf-8", errors="ignore").splitlines()
    for line in lines:
        line = line.strip()
        if not line or line.startswith(("#", ";", "[")):
            continue
        if "=" in line:
            key, val = line.split("=", 1)
            colors[key.strip()] = val.strip()
    return colors


def clean_hex(val):
    if not val:
        return None
    val = val.strip()
    parts = val.split()
    chosen = parts[-1] if parts else val
    h = chosen.lstrip("#")
    if len(h) in (6, 8):
        return h
    return None


def build_osc_payload(colors, alpha_pct):
    seqs = []

    # Foreground: OSC 10
    fg = clean_hex(colors.get("foreground"))
    if fg:
        seqs.append(f"\033]10;#{fg}\033\\")

    # Background: OSC 11 with transparency extension
    bg = clean_hex(colors.get("background"))
    if bg:
        seqs.append(f"\033]11;[{alpha_pct}]#{bg}\033\\")

    # Cursor color: OSC 12
    cursor = clean_hex(colors.get("cursor"))
    if cursor:
        seqs.append(f"\033]12;#{cursor}\033\\")

    # Selection background: OSC 17
    sel_bg = clean_hex(colors.get("selection-background"))
    if sel_bg:
        seqs.append(f"\033]17;#{sel_bg}\033\\")

    # Selection foreground: OSC 19
    sel_fg = clean_hex(colors.get("selection-foreground"))
    if sel_fg:
        seqs.append(f"\033]19;#{sel_fg}\033\\")

    # Palette 0..7: regular0..regular7
    for i in range(8):
        c = clean_hex(colors.get(f"regular{i}"))
        if c:
            seqs.append(f"\033]4;{i};#{c}\033\\")

    # Palette 8..15: bright0..bright7
    for i in range(8):
        c = clean_hex(colors.get(f"bright{i}"))
        if c:
            seqs.append(f"\033]4;{i + 8};#{c}\033\\")

    return "".join(seqs)


def discover_ptys():
    ptys = set()

    # 1. Active tmux client slave ttys
    try:
        res = subprocess.run(
            ["tmux", "list-clients", "-F", "#{client_tty}"],
            capture_output=True,
            text=True,
            check=False,
        )
        for line in res.stdout.splitlines():
            tty = line.strip()
            if tty.startswith("/dev/pts/") and os.path.exists(tty):
                ptys.add(tty)
    except Exception:
        pass

    # 2. Foot / footclient child process ttys
    try:
        res = subprocess.run(
            ["pgrep", "-x", "foot|footclient"],
            capture_output=True,
            text=True,
            check=False,
        )
        foot_pids = [p.strip() for p in res.stdout.splitlines() if p.strip()]
        for fpid in foot_pids:
            res_c = subprocess.run(
                ["pgrep", "-P", fpid],
                capture_output=True,
                text=True,
                check=False,
            )
            children = [c.strip() for c in res_c.stdout.splitlines() if c.strip()]
            for cpid in children:
                try:
                    for fd_name in ("0", "1", "2"):
                        fd_path = Path(f"/proc/{cpid}/fd/{fd_name}")
                        if fd_path.is_symlink():
                            target = str(fd_path.resolve())
                            if target.startswith("/dev/pts/") and os.path.exists(target):
                                ptys.add(target)
                except Exception:
                    pass
    except Exception:
        pass

    return sorted(ptys)


def dispatch_to_ptys(payload, ptys):
    data = payload.encode("utf-8")
    count = 0
    for pty in ptys:
        try:
            fd = os.open(pty, os.O_WRONLY | os.O_NOCTTY)
            os.write(fd, data)
            os.close(fd)
            count += 1
        except Exception:
            pass
    return count


def main():
    theme_arg = sys.argv[1] if len(sys.argv) > 1 else None
    theme_path = get_active_theme_path(theme_arg)
    if not theme_path or not theme_path.is_file():
        return

    alpha_pct = get_alpha_percentage()
    colors = parse_foot_theme(theme_path)
    payload = build_osc_payload(colors, alpha_pct)

    ptys = discover_ptys()
    dispatched = dispatch_to_ptys(payload, ptys)

    theme_name = theme_path.name
    print(f"[PASS] Foot colors reloaded: {theme_name} (alpha: {alpha_pct}%, targets: {dispatched})")


if __name__ == "__main__":
    main()
