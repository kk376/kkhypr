        "text.placeholder": "#6c7086",
        "text.disabled": "#6c7086",
        "text.accent": "#fff59b",
        "icon": "#f3edf7",
        "icon.muted": "#a9aefe",
        "icon.disabled": "#6c7086",
        "icon.accent": "#fff59b",
        "status_bar.background": "#070722",
        "title_bar.background": "#070722",
        "title_bar.inactive_background": "#070722",
        "toolbar.background": "#070722",
        "tab_bar.background": "#070722",
        "tab.inactive_background": "#11112d",
        "tab.active_background": "#070722",
        "panel.background": "#0b0b2e",
        "panel.focused_border": "#a9aefe",
        "editor.foreground": "#f3edf7",
        "editor.background": "#070722",
        "editor.gutter.background": "#070722",
        "editor.subheader.background": "#11112d",
        "editor.active_line.background": "#18183c66",
        "editor.line_number": "#6c7086",
        "editor.active_line_number": "#fff59b",
        "terminal.background": "#070722",
        "terminal.foreground": "#f3edf7",
        "terminal.ansi.black": "#11112d",
        "terminal.ansi.red": "#fd4663",
        "terminal.ansi.green": "#9bfece",
        "terminal.ansi.yellow": "#fff59b",
        "terminal.ansi.blue": "#a9aefe",
        "terminal.ansi.magenta": "#fd4663",
        "terminal.ansi.cyan": "#9bfece",
        "terminal.ansi.white": "#f3edf7",
        "terminal.ansi.bright_black": "#21215f",
        "terminal.ansi.bright_red": "#fd4663",
        "terminal.ansi.bright_green": "#9bfece",
        "terminal.ansi.bright_yellow": "#fff59b",
        "terminal.ansi.bright_blue": "#a9aefe",
        "terminal.ansi.bright_magenta": "#fd4663",
        "terminal.ansi.bright_cyan": "#9bfece",
        "terminal.ansi.bright_white": "#ffffff",
