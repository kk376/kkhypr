{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Noctalia",
  "author": "Noctalia",
  "themes": [
    {
      "name": "Noctalia",
      "appearance": "dark",
      "style": {
        "accents": [
          "#fff59b",
          "#a9aefe",
          "#9bfece",
          "#fd4663"
        ],
        "border": "#21215f",
        "border.variant": "#18183c",
        "border.focused": "#a9aefe",
        "border.selected": "#fff59b",
        "border.transparent": "#00000000",
        "border.disabled": "#21215f80",
        "elevated_surface.background": "#11112d",
        "surface.background": "#070722",
        "background": "#070722",
        "element.background": "#11112d",
        "element.hover": "#21215f",
        "element.active": "#2b2b6e",
        "element.selected": "#18183c",
        "element.disabled": "#21215f80",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#21215f80",
        "ghost_element.active": "#2b2b6e80",
        "ghost_element.selected": "#18183c80",
        "ghost_element.disabled": "#21215f40",
        "text": "#f3edf7",
