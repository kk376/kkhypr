          "number": {
            "color": "#fff59b"
          },
          "boolean": {
            "color": "#fff59b"
          },
          "type": {
            "color": "#fff59b"
          },
          "type.builtin": {
            "color": "#fff59b"
          },
          "variable": {
            "color": "#f3edf7"
          },
          "variable.special": {
            "color": "#a9aefe"
          },
          "variable.parameter": {
            "color": "#a9aefe"
          },
          "operator": {
            "color": "#ffffff"
          },
          "punctuation": {
            "color": "#ffffff"
          },
          "property": {
            "color": "#a9aefe"
          }
        }
